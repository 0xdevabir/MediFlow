# Copy to .env for local docker compose / IDE overrides. Never commit .env.

# PostgreSQL
MEDIFLOW_DB_NAME=mediflow
MEDIFLOW_DB_USER=mediflow
MEDIFLOW_DB_PASSWORD=mediflow
MEDIFLOW_DB_PORT=5432
MEDIFLOW_DB_URL=jdbc:postgresql://localhost:5432/mediflow

# Redis
MEDIFLOW_REDIS_HOST=localhost
MEDIFLOW_REDIS_PORT=6379

# RabbitMQ
MEDIFLOW_RABBIT_HOST=localhost
MEDIFLOW_RABBIT_PORT=5672
MEDIFLOW_RABBIT_MGMT_PORT=15672
MEDIFLOW_RABBIT_USER=mediflow
MEDIFLOW_RABBIT_PASSWORD=mediflow

# MinIO (S3)
MEDIFLOW_MINIO_PORT=9000
MEDIFLOW_MINIO_CONSOLE_PORT=9001
MEDIFLOW_MINIO_ENDPOINT=http://localhost:9000
MEDIFLOW_MINIO_ACCESS_KEY=mediflow
MEDIFLOW_MINIO_SECRET_KEY=mediflowsecret
MEDIFLOW_MINIO_BUCKET=mediflow

# Mail (Mailpit)
MEDIFLOW_MAIL_HOST=localhost
MEDIFLOW_MAIL_PORT=1025
MEDIFLOW_MAILPIT_SMTP_PORT=1025
MEDIFLOW_MAILPIT_UI_PORT=8025

# Field-level encryption (AES-256-GCM). 32-byte key, Base64-encoded.
# Generate: openssl rand -base64 32
MEDIFLOW_FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Spring
MEDIFLOW_SESSION_TIMEOUT_MINUTES=15
