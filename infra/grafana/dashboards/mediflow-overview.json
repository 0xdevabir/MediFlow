{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "API latency & errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "description": "Target < 500 ms (excludes actuator and SSE).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "mediflow:http_server_requests:p95_5m",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "0.5",
          "legendFormat": "SLO 500ms",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "API error rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"backend\"}[5m])), 1e-9)",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "AI pipeline",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "collapsed": false
    },
    {
      "id": 11,
      "title": "AI job p95 (end-to-end)",
      "description": "Target < 5 s. Whole draft falls back to manual if AI > 10 s.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "mediflow:ai_job:p95_5m",
          "legendFormat": "e2e p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(mediflow_ai_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ stage }}",
          "refId": "B"
        },
        {
          "expr": "5",
          "legendFormat": "SLO 5s",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "title": "AI jobs by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" }, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(mediflow_ai_jobs_total[5m]))",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Queues & SSE",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue=~\"ai\\\\.rx\\\\..*|notify\\\\..*\"})",
          "legendFormat": "{{ queue }} ready",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (rabbitmq_queue_messages_unacked{queue=~\"ai\\\\.rx\\\\..*\"})",
          "legendFormat": "{{ queue }} unacked",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "title": "SSE connections",
      "description": "Active Server-Sent Event streams (AI job progress + queue boards).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (kind) (mediflow_sse_connections)",
          "legendFormat": "{{ kind }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Clinical safety signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Red Alert count (open)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(mediflow_red_alerts_open)",
          "legendFormat": "open",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "title": "Red Alerts raised (rate)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (level) (rate(mediflow_red_alerts_raised_total[15m]))",
          "legendFormat": "{{ level }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "title": "Audit chain valid",
      "description": "1 = intact, 0 = broken (critical).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "BROKEN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "expr": "min(mediflow_audit_chain_valid)",
          "legendFormat": "chain",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Service health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 40,
      "collapsed": false
    },
    {
      "id": 41,
      "title": "Scrape up",
      "type": "stat",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mediflow"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MediFlow overview",
  "uid": "mediflow-overview",
  "version": 1
}
